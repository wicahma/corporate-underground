# SMTP (email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# S3 / Object Storage (Cloudflare R2 or AWS S3)
# Pattern: personal-porto backend-porto/internal/storage/s3.go
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=corporate-underground-media
S3_ACCESS_KEY_ID=your-r2-access-key
S3_SECRET_ACCESS_KEY=your-r2-secret-key
S3_PUBLIC_URL=https://media.diama.dev
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Session / Inactivity timeout (ms) — 24h = 86400000
SESSION_INACTIVE_TTL_MS=86400000

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Database
DATABASE_URL=postgres://diama:diama@localhost:5432/corporate_underground?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# App
PORT=8083
FRONTEND_URL=https://underground.diama.dev
NODE_ENV=production