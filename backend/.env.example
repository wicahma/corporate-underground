# SMTP (email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# S3 / Object Storage (Alist S3 or Cloudflare R2)
S3_ENDPOINT=http://localhost:5245
S3_BUCKET=bucket-corporate-underground
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_PUBLIC_URL=https://files.diama.dev/s3/bucket-corporate-underground
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Session / Inactivity timeout (ms) — 24h = 86400000
SESSION_INACTIVE_TTL_MS=86400000

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Database
DATABASE_URL=postgres://diama:diama@localhost:5432/corporate_underground?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# App
PORT=8083
FRONTEND_URL=https://underground.diama.dev
NODE_ENV=production